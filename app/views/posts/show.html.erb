<p style="color: green"><%= notice %></p>

<table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
  <tr>
    <th style="text-align: left; padding: 8px;">Title</th>
    <td style="padding: 8px;"><%= @post.title %></td>
  </tr>
  <tr>
    <th style="text-align: left; padding: 8px;">Content</th>
    <td style="padding: 8px;"><%= @post.content %></td>
  </tr>
  <tr>
    <th style="text-align: left; padding: 8px;">Author</th>
    <td style="padding: 8px;"><%= @post.author %></td>
  </tr>
  <tr>
    <th style="text-align: left; padding: 8px;">Created At</th>
    <td style="padding: 8px;"><%= @post.created_at.strftime("%B %d, %Y %I:%M %p") %></td>
  </tr>
  <tr>
    <th style="text-align: left; padding: 8px;">Updated At</th>
    <td style="padding: 8px;"><%= @post.updated_at.strftime("%B %d, %Y %I:%M %p") %></td>
  </tr>
</table>

<div style="margin-top: 20px;">
  <%= link_to "Edit this post", edit_post_path(@post), style: "padding: 8px; background: #007bff; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px;" %>
  <%= link_to "Back to posts", posts_path, style: "padding: 8px; background: #28a745; color: white; text-decoration: none; border-radius: 5px;" %>

  <%= button_to "Destroy this post", @post, method: :delete, data: { confirm: "Are you sure?" }, style: "padding: 8px; background: #dc3545; color: white; border: none; border-radius: 5px; margin-left: 10px;" %>
</div>
