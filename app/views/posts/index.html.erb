<p style="color: green; font-weight: bold;"><%= notice %></p>

<% content_for :title, "Blog Posts" %>

<div class="landing-container">
  <header>
    <h1>Welcome to My Blog</h1>
    <p>Explore the latest posts and share your thoughts!</p>
    <%= link_to "Create a New Post", new_post_path, class: "btn btn-primary" %>
  </header>

  <section class="posts-section">
    <% if @posts.any? %>
      <div class="posts-grid">
        <% @posts.each do |post| %>
          <div class="post-card">
            <h2><%= link_to post.title, post %></h2>
            <p><%= truncate(post.content, length: 100) %></p>
            <small>By <strong><%= post.author %></strong> on <%= post.created_at.strftime("%B %d, %Y") %></small>
            <div class="post-actions">
              <%= link_to "Read More", post, class: "btn btn-info" %>
              <%= link_to "Edit", edit_post_path(post), class: "btn btn-warning" %>
              <%= button_to "Delete", post, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p>No posts yet. <%= link_to "Write the first post!", new_post_path, class: "btn btn-success" %></p>
    <% end %>
  </section>
</div>
